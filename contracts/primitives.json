      "skillHeading": "#### Donut\\b"
    },
    {
      "id": "bar",
      "pickWhen": "≤12 items where order matters and a single magnitude per item is the signal",
      "register": "instrument",
      "requiredFeatures": [],
      "example": "examples/primitives/02-bar.html",
      "href": "primitives/02-bar.html",
      "reference": "references/primitives/bar.md",
      "skillHeading": "#### Bar\\b"
    },
    {
      "id": "sparkline",
      "pickWhen": "2–4 hero metrics where each metric is the subject; current value + recent-trend shape is the one-glance read",
      "register": "instrument",
      "requiredFeatures": ["inline_svg"],
      "example": "examples/primitives/03-sparkline.html",
      "href": "primitives/03-sparkline.html",
      "reference": "references/primitives/sparkline.md",
      "skillHeading": "#### Sparkline\\b"
    },
    {
      "id": "stacked-bar",
      "pickWhen": "categories sum to a meaningful whole each period; 7–30 periods",
      "register": "instrument",
      "requiredFeatures": ["cross_highlight"],
      "example": "examples/primitives/04-stacked-bar.html",
      "href": "primitives/04-stacked-bar.html",
      "reference": "references/primitives/stacked-bar.md",
      "skillHeading": "#### Stacked bar\\b"
    },
    {
      "id": "topology",
      "pickWhen": "connections are the point and node count is ≤30",
      "register": "instrument",
      "requiredFeatures": ["inline_svg"],
      "example": "examples/primitives/05-topology.html",
      "href": "primitives/05-topology.html",
      "reference": "references/primitives/topology.md",
      "skillHeading": "#### Topology\\b"
    },
    {
      "id": "dense-ops-table",
      "pickWhen": "flat list of records keyed by an identifier; ≥6 rows; filter/sort is the central interaction",
      "register": "instrument",
      "requiredFeatures": ["table"],
      "example": "examples/primitives/06-table-ops.html",
      "href": "primitives/06-table-ops.html",
      "reference": "references/primitives/dense-ops-table.md",
      "skillHeading": "#### Dense ops table\\b"
    },
    {
      "id": "comparison-matrix",
      "pickWhen": "X vs Y vs Z decision matrix with shared criteria and live weight tuning",
      "register": "instrument",
      "requiredFeatures": ["table"],
      "example": "examples/primitives/07-table-comparison.html",
      "href": "primitives/07-table-comparison.html",
      "reference": "references/primitives/comparison-matrix.md",
      "skillHeading": "#### Comparison matrix\\b"
    },
    {
      "id": "annotated-diff",
      "pickWhen": "code changes or line-anchored critique where adjacency to the source beats a side panel",
      "register": "instrument",
      "requiredFeatures": ["copy_as_prompt"],
      "example": "examples/primitives/08-diff.html",
      "href": "primitives/08-diff.html",
      "reference": "references/primitives/annotated-diff.md",
      "skillHeading": "#### Annotated diff\\b"
    },
    {
      "id": "log-stream",
      "pickWhen": "a tail of timestamped events with a categorical level; newest-first reading",
      "register": "instrument",
      "requiredFeatures": ["filtering"],
      "example": "examples/primitives/09-logs.html",
      "href": "primitives/09-logs.html",
      "reference": "references/primitives/log-stream.md",
      "skillHeading": "#### Log stream\\b"
    },
    {
      "id": "scatter",
      "pickWhen": "two genuinely independent, well-spread dimensions across ≥10 points where the relationship is the signal",
      "register": "instrument",
      "requiredFeatures": ["inline_svg"],
      "example": "examples/primitives/10-scatter.html",
      "href": "primitives/10-scatter.html",
      "reference": "references/primitives/scatter.md",
      "skillHeading": "#### Scatter\\b"
    }
  ]
